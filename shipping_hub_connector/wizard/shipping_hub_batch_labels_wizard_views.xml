<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipping_hub_batch_labels_wizard_form" model="ir.ui.view">
        <field name="name">shipping.hub.batch.labels.wizard.form</field>
        <field name="model">shipping.hub.batch.labels.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Shipping Hub labels">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="label_pdf" filename="filename" invisible="not label_pdf"/>
                    <field name="errors_summary" invisible="not errors_summary"/>
                </group>
                <footer>
                    <button name="action_download_merged_pdf"
                            string="Download merged PDF"
                            type="object"
                            class="btn-primary"
                            invisible="not label_pdf"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
