msgid "Not eligible for batch label generation."
msgstr "Niet geschikt voor batch labelgeneratie."

#. module: shipping_hub_connector
msgid "No tracking number available."
msgstr "Geen trackingnummer beschikbaar."

#. module: shipping_hub_connector
msgid "No public tracking URL configured for this carrier code."
msgstr "Geen openbare tracking-URL voor deze vervoerderscode."

#. module: shipping_hub_connector
msgid "Unknown error"
msgstr "Onbekende fout"

#. module: shipping_hub_connector
msgid ""
"Incomplete shipment data (address, postal code, weight, or carrier "
"settings)."
msgstr ""
"Onvolledige verzendgegevens (adres, postcode, gewicht of "
"vervoerderinstellingen)."

#. module: shipping_hub_connector
msgid "Monthly label quota has been reached."
msgstr "Maandelijks labelquotum bereikt."

#. module: shipping_hub_connector
msgid "Too many requests; please wait about one minute and try again."
msgstr "Te veel verzoeken; wacht ongeveer een minuut en probeer opnieuw."

#. module: shipping_hub_connector
msgid "Carrier API credentials are missing in the Shipping Hub portal."
msgstr "Vervoerder-API-gegevens ontbreken in het Shipping Hub-portaal."

#. module: shipping_hub_connector
msgid "Your Shipping Hub subscription is not active."
msgstr "Uw Shipping Hub-abonnement is niet actief."

#. module: shipping_hub_connector
msgid "Invalid API token. Update it in Inventory settings."
msgstr "Ongeldig API-token. Werk bij in Voorraadinstellingen."

#. module: shipping_hub_connector
msgid "Request signature rejected. Check the API token."
msgstr "Handtekening verzoek geweigerd. Controleer het API-token."

#. module: shipping_hub_connector
msgid "Request timestamp out of range. Sync server time."
msgstr "Tijdstempel buiten bereik. Synchroniseer servertijd."

#. module: shipping_hub_connector
msgid "Duplicate request nonce. Try again."
msgstr "Dubbele nonce. Probeer opnieuw."

#. module: shipping_hub_connector
msgid "The carrier rejected the shipment request."
msgstr "De vervoerder heeft het verzoek geweigerd."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway URL is not configured."
msgstr "Shipping Hub-gateway-URL is niet geconfigureerd."

#. module: shipping_hub_connector
msgid "Shipping Hub API token is missing or too short."
msgstr "Shipping Hub API-token ontbreekt of is te kort."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway timed out. Try again later."
msgstr "Gateway-time-out. Probeer het later opnieuw."

#. module: shipping_hub_connector
msgid "Could not reach the Shipping Hub gateway. Check URL and network."
msgstr "Gateway niet bereikbaar. Controleer URL en netwerk."

#. module: shipping_hub_connector
msgid "Unexpected success on connection test."
msgstr "Onverwacht succes bij verbindingstest."

#. module: shipping_hub_connector
msgid "API token rejected by the gateway (401)."
msgstr "API-token geweigerd door gateway (401)."

#. module: shipping_hub_connector
msgid "Python package pypdf is required for batch PDF merge."
msgstr "Python-pakket pypdf is vereist voor batch PDF-samenvoeging."

#. module: shipping_hub_connector
msgid "No merged PDF available. Check the error summary."
msgstr "Geen samengevoegde PDF. Bekijk het foutoverzicht."

#. module: shipping_hub_connector
msgid "Hub carrier code is required for Shipping Hub delivery methods."
msgstr "Hub-vervoerderscode is verplicht voor Shipping Hub-methoden."

#. module: shipping_hub_connector
msgid ""
"Label issue failed (%(carrier)s)\n"
"Could not generate a label for order %(ref)s.\n"
"Reason from the Hub:\n"
"%(reason)s\n"
msgstr ""
"⚠️ Label aanmaken mislukt (%(carrier)s)\n"
"Kon geen label genereren voor order %(ref)s.\n"
"Reden van de Hub:\n"
"❌ %(reason)s\n"

#. module: shipping_hub_connector
msgid ""
"Label and tracking code removed from Odoo by %(user)s. Cancellation with the"
" carrier must be handled manually."
msgstr ""
"⚠️ Label en trackingcode verwijderd uit Odoo door %(user)s. Annulering bij "
"de vervoerder moet handmatig gebeuren."

#. module: shipping_hub_connector
msgid ""
"Warehouse partner is missing for %(picking)s. Complete the warehouse "
"address."
msgstr ""
"Magazijnpartner ontbreekt voor %(picking)s. Vul het magazijnadres aan."

#. module: shipping_hub_connector
msgid "Delivery address (customer) is missing on %(picking)s."
msgstr "Leveradres (klant) ontbreekt op %(picking)s."

#. module: shipping_hub_connector
msgid "Shipping weight must be greater than zero on %(picking)s."
msgstr "Verzendgewicht moet > 0 zijn op %(picking)s."

#. module: shipping_hub_connector
msgid "Gateway health check failed (%(url)s)."
msgstr "Gateway health check mislukt (%(url)s)."

#. module: shipping_hub_connector
msgid "Connection test failed: %(msg)s"
msgstr "Verbindingstest mislukt: %(msg)s"

#. module: shipping_hub_connector
msgid "Quota: %(used)s / %(limit)s (%(plan)s)"
msgstr "Quotum: %(used)s / %(limit)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Quota used: %(used)s (%(plan)s)"
msgstr "Quotum gebruikt: %(used)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Partner %(name)s has no country set."
msgstr "Partner %(name)s heeft geen land ingesteld."

#. module: shipping_hub_connector
msgid "Partner %(name)s has no street address."
msgstr "Partner %(name)s heeft geen straatadres."

#. module: shipping_hub_connector
msgid "Partner %(name)s needs postal code and city."
msgstr "Partner %(name)s heeft postcode en plaats nodig."

