#. module: shipping_hub_connector
msgid "Generate Hub Label"
msgstr "Generuj etykietę Hub"

#. module: shipping_hub_connector
msgid "Cancel Label"
msgstr "Anuluj etykietę"

#. module: shipping_hub_connector
msgid "Do you want to cancel this label with the carrier?"
msgstr "Czy anulować tę etykietę u przewoźnika?"

#. module: shipping_hub_connector
msgid "Generate Hub Labels (batch)"
msgstr "Generuj etykiety Hub zbiorczo"

#. module: shipping_hub_connector
msgid "Freight information"
msgstr "Informacje o przesyłce"

#. module: shipping_hub_connector
msgid "Open carrier tracking"
msgstr "Otwórz śledzenie przewoźnika"

#. module: shipping_hub_connector
msgid "Shipping Hub Connector"
msgstr "Łącznik Shipping Hub"

#. module: shipping_hub_connector
msgid "SaaS credentials"
msgstr "Dane logowania SaaS"

#. module: shipping_hub_connector
msgid "API token and environment for the Shipping Hub gateway."
msgstr "Token API i środowisko bramki Shipping Hub."

#. module: shipping_hub_connector
msgid "Optional URL override"
msgstr "Opcjonalne nadpisanie URL"

#. module: shipping_hub_connector
msgid "Test connection"
msgstr "Test połączenia"

#. module: shipping_hub_connector
msgid "Automation rules"
msgstr "Reguły automatyzacji"

#. module: shipping_hub_connector
msgid "When to generate labels and attach PDFs to the picking chatter."
msgstr "Kiedy generować etykiety i dołączać PDF do czatu operacji."

#. module: shipping_hub_connector
msgid "Batch Shipping Hub labels"
msgstr "Etykiety Shipping Hub (partia)"

#. module: shipping_hub_connector
msgid "Download merged PDF"
msgstr "Pobierz scalony PDF"

#. module: shipping_hub_connector
msgid "Close"
msgstr "Zamknij"

#. module: shipping_hub_connector
msgid "Hub label id"
msgstr "ID etykiety Hub"

#. module: shipping_hub_connector
msgid "Last Hub error"
msgstr "Ostatni błąd Hub"

#. module: shipping_hub_connector
msgid "Shipping Hub API Token"
msgstr "Token API Shipping Hub"

#. module: shipping_hub_connector
msgid "Environment"
msgstr "Środowisko"

#. module: shipping_hub_connector
msgid "Sandbox"
msgstr "Sandbox"

#. module: shipping_hub_connector
msgid "Production"
msgstr "Produkcja"

#. module: shipping_hub_connector
msgid "Generate label on picking validation"
msgstr "Generuj etykietę przy walidacji operacji"

#. module: shipping_hub_connector
msgid "Attach label PDF to Chatter"
msgstr "Dołącz PDF etykiety do czatu"

#. module: shipping_hub_connector
msgid "Gateway base URL (override)"
msgstr "Bazowy URL bramki (nadpisanie)"

#. module: shipping_hub_connector
msgid "Hub carrier code"
msgstr "Kod przewoźnika Hub"

#. module: shipping_hub_connector
msgid "Service level"
msgstr "Poziom usługi"

#. module: shipping_hub_connector
msgid "Shipping Hub Europe"
msgstr "Shipping Hub Europe"

#. module: shipping_hub_connector
msgid "Merged labels PDF"
msgstr "Scalony PDF etykiet"

#. module: shipping_hub_connector
msgid "Filename"
msgstr "Nazwa pliku"

#. module: shipping_hub_connector
msgid "Errors"
msgstr "Błędy"

#. module: shipping_hub_connector
msgid "Carrier"
msgstr "Przewoźnik"

#. module: shipping_hub_connector
msgid "Shipping Hub"
msgstr "Shipping Hub"

#. module: shipping_hub_connector
msgid "Connection successful. Token and gateway are reachable."
msgstr "Połączenie udane. Token i bramka są dostępne."

#. module: shipping_hub_connector
msgid "Shipping label generated via Shipping Hub."
msgstr "Etykieta wysyłki wygenerowana przez Shipping Hub."

#. module: shipping_hub_connector
msgid "This delivery is not eligible for a Shipping Hub label."
msgstr "Ta dostawa nie kwalifikuje się do etykiety Shipping Hub."

#. module: shipping_hub_connector
msgid "Not eligible for batch label generation."
msgstr "Nie kwalifikuje się do zbiorczej generacji etykiet."

#. module: shipping_hub_connector
msgid "No tracking number available."
msgstr "Brak numeru śledzenia."

#. module: shipping_hub_connector
msgid "No public tracking URL configured for this carrier code."
msgstr "Brak publicznego URL śledzenia dla tego kodu przewoźnika."

#. module: shipping_hub_connector
msgid "Unknown error"
msgstr "Nieznany błąd"

#. module: shipping_hub_connector
msgid ""
"Incomplete shipment data (address, postal code, weight, or carrier "
"settings)."
msgstr ""
"Niekompletne dane przesyłki (adres, kod pocztowy, waga lub ustawienia "
"przewoźnika)."

#. module: shipping_hub_connector
msgid "Monthly label quota has been reached."
msgstr "Wyczerpano miesięczny limit etykiet."

#. module: shipping_hub_connector
msgid "Too many requests; please wait about one minute and try again."
msgstr "Zbyt wiele żądań; odczekaj około minuty i spróbuj ponownie."

#. module: shipping_hub_connector
msgid "Carrier API credentials are missing in the Shipping Hub portal."
msgstr "Brak danych API przewoźnika w portalu Shipping Hub."

#. module: shipping_hub_connector
msgid "Your Shipping Hub subscription is not active."
msgstr "Subskrypcja Shipping Hub jest nieaktywna."

#. module: shipping_hub_connector
msgid "Invalid API token. Update it in Inventory settings."
msgstr "Nieprawidłowy token API. Zaktualizuj w ustawieniach Magazynu."

#. module: shipping_hub_connector
msgid "Request signature rejected. Check the API token."
msgstr "Odrzucono podpis żądania. Sprawdź token API."

#. module: shipping_hub_connector
msgid "Request timestamp out of range. Sync server time."
msgstr "Znacznik czasu poza zakresem. Zsynchronizuj czas serwera."

#. module: shipping_hub_connector
msgid "Duplicate request nonce. Try again."
msgstr "Zduplikowany nonce. Spróbuj ponownie."

#. module: shipping_hub_connector
msgid "The carrier rejected the shipment request."
msgstr "Przewoźnik odrzucił żądanie wysyłki."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway URL is not configured."
msgstr "Nie skonfigurowano URL bramki Shipping Hub."

#. module: shipping_hub_connector
msgid "Shipping Hub API token is missing or too short."
msgstr "Brak tokena API Shipping Hub lub jest zbyt krótki."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway timed out. Try again later."
msgstr "Przekroczono czas oczekiwania bramki. Spróbuj później."

#. module: shipping_hub_connector
msgid "Could not reach the Shipping Hub gateway. Check URL and network."
msgstr "Nie można połączyć z bramką. Sprawdź URL i sieć."

#. module: shipping_hub_connector
msgid "Unexpected success on connection test."
msgstr "Nieoczekiwany sukces testu połączenia."

#. module: shipping_hub_connector
msgid "API token rejected by the gateway (401)."
msgstr "Token API odrzucony przez bramkę (401)."

#. module: shipping_hub_connector
msgid "Python package pypdf is required for batch PDF merge."
msgstr "Pakiet Python pypdf jest wymagany do scalania PDF."

#. module: shipping_hub_connector
msgid "No merged PDF available. Check the error summary."
msgstr "Brak scalonego PDF. Sprawdź podsumowanie błędów."

#. module: shipping_hub_connector
msgid "Hub carrier code is required for Shipping Hub delivery methods."
msgstr "Kod przewoźnika Hub jest wymagany dla metod Shipping Hub."

#. module: shipping_hub_connector
msgid ""
"Label issue failed (%(carrier)s)\n"
"Could not generate a label for order %(ref)s.\n"
"Reason from the Hub:\n"
"%(reason)s\n"
msgstr ""
"⚠️ Nie udało się wygenerować etykiety (%(carrier)s)\n"
"Nie można wygenerować etykiety dla zamówienia %(ref)s.\n"
"Powód z Hub:\n"
"❌ %(reason)s\n"

#. module: shipping_hub_connector
msgid ""
"Label and tracking code removed from Odoo by %(user)s. Cancellation with the"
" carrier must be handled manually."
msgstr ""
"⚠️ Etykieta i numer śledzenia usunięte z Odoo przez %(user)s. Anulowanie u "
"przewoźnika wymaga ręcznej obsługi."

#. module: shipping_hub_connector
msgid ""
"Warehouse partner is missing for %(picking)s. Complete the warehouse "
"address."
msgstr "Brak partnera magazynu dla %(picking)s. Uzupełnij adres magazynu."

#. module: shipping_hub_connector
msgid "Delivery address (customer) is missing on %(picking)s."
msgstr "Brak adresu dostawy (klient) dla %(picking)s."

#. module: shipping_hub_connector
msgid "Shipping weight must be greater than zero on %(picking)s."
msgstr "Waga wysyłki musi być > 0 dla %(picking)s."

#. module: shipping_hub_connector
msgid "Gateway health check failed (%(url)s)."
msgstr "Test health check bramki nie powiódł się (%(url)s)."

#. module: shipping_hub_connector
msgid "Connection test failed: %(msg)s"
msgstr "Test połączenia nie powiódł się: %(msg)s"

#. module: shipping_hub_connector
msgid "Quota: %(used)s / %(limit)s (%(plan)s)"
msgstr "Limit: %(used)s / %(limit)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Quota used: %(used)s (%(plan)s)"
msgstr "Wykorzystano: %(used)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Partner %(name)s has no country set."
msgstr "Partner %(name)s nie ma ustawionego kraju."

#. module: shipping_hub_connector
msgid "Partner %(name)s has no street address."
msgstr "Partner %(name)s nie ma adresu ulicy."

#. module: shipping_hub_connector
msgid "Partner %(name)s needs postal code and city."
msgstr "Partner %(name)s wymaga kodu pocztowego i miasta."

#. module: shipping_hub_connector
#: code:addons/shipping_hub_connector/models/stock_picking.py:0
msgid "Number of packages"
msgstr "Liczba paczek"

#. module: shipping_hub_connector
#: code:addons/shipping_hub_connector/models/stock_picking.py:0
msgid ""
"Number of physical parcels (colli) sent to the Hub for label generation."
msgstr ""
"Liczba fizycznych paczek (colli) wysyłanych do Hubu w celu wygenerowania "
"etykiety."
