msgstr "URL base gateway (override)"

#. module: shipping_hub_connector
msgid "Hub carrier code"
msgstr "Codice corriere Hub"

#. module: shipping_hub_connector
msgid "Service level"
msgstr "Livello di servizio"

#. module: shipping_hub_connector
msgid "Shipping Hub Europe"
msgstr "Shipping Hub Europe"

#. module: shipping_hub_connector
msgid "Merged labels PDF"
msgstr "PDF etichette unite"

#. module: shipping_hub_connector
msgid "Filename"
msgstr "Nome file"

#. module: shipping_hub_connector
msgid "Errors"
msgstr "Errori"

#. module: shipping_hub_connector
msgid "Carrier"
msgstr "Corriere"

#. module: shipping_hub_connector
msgid "Shipping Hub"
msgstr "Shipping Hub"

#. module: shipping_hub_connector
msgid "Connection successful. Token and gateway are reachable."
msgstr "Connessione riuscita. Token e gateway raggiungibili."

#. module: shipping_hub_connector
msgid "Shipping label generated via Shipping Hub."
msgstr "Etichetta di spedizione generata via Shipping Hub."

#. module: shipping_hub_connector
msgid "This delivery is not eligible for a Shipping Hub label."
msgstr "Questa consegna non è idonea per un'etichetta Shipping Hub."

#. module: shipping_hub_connector
msgid "Not eligible for batch label generation."
msgstr "Non idoneo per generazione etichette in batch."

#. module: shipping_hub_connector
msgid "No tracking number available."
msgstr "Nessun numero di tracking disponibile."

#. module: shipping_hub_connector
msgid "No public tracking URL configured for this carrier code."
msgstr "Nessun URL di tracking pubblico per questo codice corriere."

#. module: shipping_hub_connector
msgid "Unknown error"
msgstr "Errore sconosciuto"

#. module: shipping_hub_connector
msgid ""
"Incomplete shipment data (address, postal code, weight, or carrier "
"settings)."
msgstr ""
"Dati spedizione incompleti (indirizzo, CAP, peso o impostazioni corriere)."

#. module: shipping_hub_connector
msgid "Monthly label quota has been reached."
msgstr "Quota mensile etichette esaurita."

#. module: shipping_hub_connector
msgid "Too many requests; please wait about one minute and try again."
msgstr "Troppe richieste; attendere circa un minuto e riprovare."

#. module: shipping_hub_connector
msgid "Carrier API credentials are missing in the Shipping Hub portal."
msgstr "Credenziali API corriere mancanti nel portale Shipping Hub."

#. module: shipping_hub_connector
msgid "Your Shipping Hub subscription is not active."
msgstr "L'abbonamento Shipping Hub non è attivo."

#. module: shipping_hub_connector
msgid "Invalid API token. Update it in Inventory settings."
msgstr "Token API non valido. Aggiornarlo nelle impostazioni Magazzino."

#. module: shipping_hub_connector
msgid "Request signature rejected. Check the API token."
msgstr "Firma richiesta rifiutata. Verificare il token API."

#. module: shipping_hub_connector
msgid "Request timestamp out of range. Sync server time."
msgstr "Timestamp fuori intervallo. Sincronizzare l'ora del server."

#. module: shipping_hub_connector
msgid "Duplicate request nonce. Try again."
msgstr "Nonce duplicato. Riprovare."

#. module: shipping_hub_connector
msgid "The carrier rejected the shipment request."
msgstr "Il corriere ha rifiutato la richiesta di spedizione."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway URL is not configured."
msgstr "URL gateway Shipping Hub non configurato."

#. module: shipping_hub_connector
msgid "Shipping Hub API token is missing or too short."
msgstr "Token API Shipping Hub mancante o troppo corto."

#. module: shipping_hub_connector
msgid "Shipping Hub gateway timed out. Try again later."
msgstr "Timeout gateway. Riprovare più tardi."

#. module: shipping_hub_connector
msgid "Could not reach the Shipping Hub gateway. Check URL and network."
msgstr "Gateway non raggiungibile. Verificare URL e rete."

#. module: shipping_hub_connector
msgid "Unexpected success on connection test."
msgstr "Successo imprevisto nel test di connessione."

#. module: shipping_hub_connector
msgid "API token rejected by the gateway (401)."
msgstr "Token API rifiutato dal gateway (401)."

#. module: shipping_hub_connector
msgid "Python package pypdf is required for batch PDF merge."
msgstr "Il pacchetto Python pypdf è richiesto per il merge PDF batch."

#. module: shipping_hub_connector
msgid "No merged PDF available. Check the error summary."
msgstr "Nessun PDF unificato. Controllare il riepilogo errori."

#. module: shipping_hub_connector
msgid "Hub carrier code is required for Shipping Hub delivery methods."
msgstr "Codice corriere Hub obbligatorio per metodi Shipping Hub."

#. module: shipping_hub_connector
msgid ""
"Label issue failed (%(carrier)s)\n"
"Could not generate a label for order %(ref)s.\n"
"Reason from the Hub:\n"
"%(reason)s\n"
msgstr ""
"⚠️ Emissione etichetta non riuscita (%(carrier)s)\n"
"Impossibile generare l'etichetta per l'ordine %(ref)s.\n"
"Motivo dal Hub:\n"
"❌ %(reason)s\n"

#. module: shipping_hub_connector
msgid ""
"Label and tracking code removed from Odoo by %(user)s. Cancellation with the"
" carrier must be handled manually."
msgstr ""
"⚠️ Etichetta e tracking rimossi da Odoo da %(user)s. L'annullamento con il "
"corriere va gestito manualmente."

#. module: shipping_hub_connector
msgid ""
"Warehouse partner is missing for %(picking)s. Complete the warehouse "
"address."
msgstr "Partner magazzino mancante per %(picking)s. Completare l'indirizzo."

#. module: shipping_hub_connector
msgid "Delivery address (customer) is missing on %(picking)s."
msgstr "Indirizzo di consegna (cliente) mancante su %(picking)s."

#. module: shipping_hub_connector
msgid "Shipping weight must be greater than zero on %(picking)s."
msgstr "Il peso spedizione deve essere > 0 su %(picking)s."

#. module: shipping_hub_connector
msgid "Gateway health check failed (%(url)s)."
msgstr "Health check gateway non riuscito (%(url)s)."

#. module: shipping_hub_connector
msgid "Connection test failed: %(msg)s"
msgstr "Test connessione fallito: %(msg)s"

#. module: shipping_hub_connector
msgid "Quota: %(used)s / %(limit)s (%(plan)s)"
msgstr "Quota: %(used)s / %(limit)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Quota used: %(used)s (%(plan)s)"
msgstr "Quota usata: %(used)s (%(plan)s)"

#. module: shipping_hub_connector
msgid "Partner %(name)s has no country set."
msgstr "Partner %(name)s senza paese impostato."

#. module: shipping_hub_connector
msgid "Partner %(name)s has no street address."
msgstr "Partner %(name)s senza indirizzo."

#. module: shipping_hub_connector
msgid "Partner %(name)s needs postal code and city."
msgstr "Partner %(name)s richiede CAP e città."

#. module: shipping_hub_connector
#: code:addons/shipping_hub_connector/models/stock_picking.py:0
msgid "Number of packages"
msgstr "Numero colli"

#. module: shipping_hub_connector
#: code:addons/shipping_hub_connector/models/stock_picking.py:0
msgid ""
"Number of physical parcels (colli) sent to the Hub for label generation."
msgstr "Numero di colli fisici inviati all'Hub per generare l'etichetta."
