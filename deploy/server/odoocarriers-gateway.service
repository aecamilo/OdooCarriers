[Unit]
Description=OdooCarriers Hub Gateway (FastAPI / uvicorn)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=alexander
Group=alexander
WorkingDirectory=/home/alexander/odoocarriers/hub-gateway
EnvironmentFile=/home/alexander/odoocarriers/hub-gateway/.env
ExecStart=/home/alexander/odoocarriers/hub-gateway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
