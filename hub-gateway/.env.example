# OdooCarriers Hub Gateway — copiar para .env e preencher (não versionar .env)

APP_NAME=OdooCarriers
APP_DEBUG=true
# Local dev com túnel: ./scripts/mysql-tunnel-dev.sh → DB_PORT=3307 (ver docs/AMBIENTE_TESTES_HETZNER.md)
APP_URL=http://127.0.0.1:8000
# Testes públicos (TLS): https://stip.pt/hub-test — ou https://hub-test.stip.pt após DNS + certbot
APP_PUBLIC_URL=https://stip.pt/hub-test

# MySQL — servidor de testes: base odoocarriers, user saas (túnel: scripts/mysql-tunnel-dev.sh)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=odoocarriers
DB_USERNAME=saas
DB_PASSWORD=change-me

# Segurança / IAP (obrigatório antes de produção)
# SAAS_KEY_PEPPER=
# IAP_SERVICE_KEY=
# GATEWAY_SECRETS_KEY=   # Fernet (credenciais DPD em connection_secrets)
# REQUIRE_ODOO_DATABASE_UUID=true

# Dev: simulador de transportadora (nunca true em produção)
# GATEWAY_CARRIER_SIMULATOR=true

SC_HMAC_MAX_SKEW_SEC=300
SC_HMAC_REQUIRED=true

GATEWAY_CARRIER_SIMULATOR=true
IAP_SERVICE_NAME=odoocarriers_shipping_labels
